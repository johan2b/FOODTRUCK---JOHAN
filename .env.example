# Copiar a .env solo al preparar un entorno nuevo. No contiene credenciales reales.
# npm run dev y npm run preview fijan sus valores locales desde sus scripts.
APP_ENV=development
RUTA=http://localhost:5173
LANG_DEFAULT=es

# Ejercicios: desactivado. No simula un envío correcto.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_WEB=info@example.com
EMAIL_ADMIN=admin@example.com

# Opcional: vacío significa que no se incluye el script de CookieLad.
COOKIELAD_API_KEY=
